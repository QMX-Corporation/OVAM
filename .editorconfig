# OVAM (Open Vallen Ard Man) Firmware Format Matrix
# Copyright (C) 2026 QMX Corporation

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{asm,inc}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{sh,bat}]
end_of_line = lf
indent_size = 4
